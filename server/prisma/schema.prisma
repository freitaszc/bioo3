generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int             @id @default(autoincrement())
  username         String          @unique
  passwordHash     String
  firstName        String          @default("")
  secondName       String          @default("")
  birthdate        DateTime?
  email            String?         @unique
  profileImagePath String          @default("/assets/user-icon.png")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  analysisEvents   AnalysisEvent[]
  role             String          @default("CLINIC")
  clinicId         Int?            @unique
  clinic           Clinic?         @relation(fields: [clinicId], references: [id], onDelete: SetNull)
}

model Clinic {
  id              Int             @id @default(autoincrement())
  name            String
  status          String          @default("PENDING")
  rejectionReason String          @default("")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User?
  analysisEvents  AnalysisEvent[]
  doctors         Doctor[]
  patients        Patient[]
  products        Product[]
  agendaEvents    AgendaEvent[]
  consultations   Consultation[]

  @@index([name])
  @@index([status])
}

model AnalysisEvent {
  id        Int      @id @default(autoincrement())
  userId    Int?
  source    String   @default("pdf")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  clinicId  Int
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([userId])
  @@index([clinicId])
}

model Video {
  id         Int      @id @default(autoincrement())
  title      String
  playbackId String   @unique
  pdf        String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Doctor {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @default("")
  councilType   String @default("")
  councilNumber String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patients  Patient[]
  clinicId  Int
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@unique([clinicId, name])
  @@index([clinicId])
}

model ReferenceOverride {
  id        Int      @id @default(autoincrement())
  testName  String
  ideal     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([testName])
}

model Patient {
  id            Int            @id @default(autoincrement())
  name          String
  age           Int
  cpf           String         @default("")
  gender        String         @default("")
  phone         String         @default("")
  status        String         @default("Ativo")
  prescription  String         @default("")
  doctorId      Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  doctor        Doctor?        @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  consultations Consultation[]
  clinicId      Int
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([status])
  @@index([doctorId])
  @@index([clinicId])
}

model Consultation {
  id        Int      @id @default(autoincrement())
  patientId Int
  notes     String   @default("")
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicId  Int
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([createdAt])
  @@index([clinicId])
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  quantity      Int      @default(0)
  minStock      Int      @default(5)
  purchasePrice Decimal  @default(0) @db.Decimal(10, 2)
  salePrice     Decimal  @default(0) @db.Decimal(10, 2)
  status        String   @default("Ativo")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  clinicId      Int
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([status])
  @@index([clinicId])
}

model AgendaEvent {
  id        Int      @id @default(autoincrement())
  title     String
  startsAt  DateTime
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinicId  Int
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([startsAt])
  @@index([clinicId])
}
