generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int             @id @default(autoincrement())
  username         String          @unique
  passwordHash     String
  firstName        String          @default("")
  email            String?         @unique
  profileImagePath String          @default("/assets/user-icon.png")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  analysisEvents   AnalysisEvent[]
  stockMovements   StockMovement[]
  sales            Sale[]
  payments         Payment[]
  role             String          @default("CLINIC")
  clinicId         Int?            @unique
  clinic           Clinic?         @relation(fields: [clinicId], references: [id], onDelete: SetNull)
}

model Clinic {
  id              Int             @id @default(autoincrement())
  name            String
  status          String          @default("PENDING")
  rejectionReason String          @default("")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User?
  analysisEvents  AnalysisEvent[]
  doctors         Doctor[]
  patients        Patient[]
  products        Product[]
  agendaEvents    AgendaEvent[]
  consultations   Consultation[]
  patientPlans    PatientPlan[]
  suppliers       Supplier[]
  stockLots       StockLot[]
  stockMovements  StockMovement[]
  sales           Sale[]
  payments        Payment[]
  receipts        Receipt[]
  fiscalDocuments FiscalDocument[]

  @@index([name])
  @@index([status])
}

model AnalysisEvent {
  id        Int      @id @default(autoincrement())
  userId    Int?
  patientId Int?
  source    String   @default("pdf")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  clinicId  Int
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([userId])
  @@index([patientId])
  @@index([clinicId])
}

model Video {
  id         Int      @id @default(autoincrement())
  title      String
  playbackId String   @unique
  pdf        String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Doctor {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @default("")
  councilType   String @default("")
  councilNumber String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patients  Patient[]
  clinicId  Int
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@unique([clinicId, name])
  @@index([clinicId])
}

model ReferenceOverride {
  id        Int      @id @default(autoincrement())
  testName  String
  ideal     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([testName])
}

model Patient {
  id            Int            @id @default(autoincrement())
  name          String
  age           Int
  cpf           String         @default("")
  gender        String         @default("")
  phone         String         @default("")
  status        String         @default("Ativo")
  prescription  String         @default("")
  doctorId      Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  doctor        Doctor?        @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  consultations Consultation[]
  analysisEvents AnalysisEvent[]
  patientPlans  PatientPlan[]
  stockMovements StockMovement[]
  sales          Sale[]
  receipts       Receipt[]
  clinicId      Int
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([status])
  @@index([doctorId])
  @@index([clinicId])
}

model Consultation {
  id        Int      @id @default(autoincrement())
  patientId Int
  notes     String   @default("")
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicId  Int
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([createdAt])
  @@index([clinicId])
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  quantity      Int      @default(0)
  minStock      Int      @default(5)
  purchasePrice Decimal  @default(0) @db.Decimal(10, 2)
  salePrice     Decimal  @default(0) @db.Decimal(10, 2)
  status        String   @default("Ativo")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  clinicId      Int
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  stockLots     StockLot[]
  stockMovements StockMovement[]
  saleItems     SaleItem[]

  @@index([name])
  @@index([status])
  @@index([clinicId])
}

model PlanTemplate {
  id          Int                @id @default(autoincrement())
  name        String
  description String             @default("")
  frequency   String
  sessions    Int                @default(4)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       PlanTemplateItem[]
  patientPlans PatientPlan[]

  @@index([name])
}

model PlanTemplateItem {
  id           Int         @id @default(autoincrement())
  templateId   Int
  productName  String
  route        String
  preparation  String      @default("")
  application  String      @default("")
  quantity     Int
  unit         String      @default("DOSE")
  sessions     Int         @default(4)
  intervalDays Int         @default(7)
  unitPrice    Decimal     @default(0) @db.Decimal(10, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  template    PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model PatientPlan {
  id          Int          @id @default(autoincrement())
  patientId   Int
  clinicId    Int
  templateId  Int?
  name        String
  description String       @default("")
  frequency   String
  sessions    Int
  status      String       @default("QUOTE")
  items       Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  template    PlanTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  planSessions PlanSession[]
  stockMovements StockMovement[]
  sales        Sale[]

  @@index([patientId])
  @@index([clinicId])
  @@index([templateId])
  @@index([status])
}

model PlanSession {
  id            Int         @id @default(autoincrement())
  patientPlanId Int
  number        Int
  status        String      @default("PENDING")
  scheduledAt   DateTime?
  completedAt   DateTime?
  notes         String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  patientPlan   PatientPlan @relation(fields: [patientPlanId], references: [id], onDelete: Cascade)

  @@unique([patientPlanId, number])
  @@index([patientPlanId])
  @@index([status])
}

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String
  contact   String    @default("")
  phone     String    @default("")
  email     String    @default("")
  notes     String    @default("")
  clinicId  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  stockLots StockLot[]

  @@unique([clinicId, name])
  @@index([clinicId])
  @@index([name])
}

model StockLot {
  id           Int             @id @default(autoincrement())
  productId    Int
  clinicId     Int
  supplierId   Int?
  batchNumber  String
  expiresAt    DateTime?
  quantity     Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  clinic       Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  supplier     Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements    StockMovement[]

  @@unique([productId, batchNumber])
  @@index([clinicId])
  @@index([productId])
  @@index([supplierId])
  @@index([expiresAt])
}

model StockMovement {
  id            Int          @id @default(autoincrement())
  productId     Int
  clinicId      Int
  lotId         Int?
  userId        Int?
  patientId     Int?
  patientPlanId Int?
  saleId        Int?
  type          String
  quantity      Int
  reason        String       @default("")
  createdAt     DateTime     @default(now())
  product       Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  lot           StockLot?    @relation(fields: [lotId], references: [id], onDelete: SetNull)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  patient       Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientPlan   PatientPlan? @relation(fields: [patientPlanId], references: [id], onDelete: SetNull)
  sale          Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([clinicId])
  @@index([lotId])
  @@index([userId])
  @@index([patientId])
  @@index([patientPlanId])
  @@index([saleId])
  @@index([type])
  @@index([createdAt])
}

model Sale {
  id               Int           @id @default(autoincrement())
  clinicId         Int
  patientId        Int?
  patientPlanId    Int?
  createdById      Int?
  source           String
  status           String        @default("OPEN")
  subtotal         Decimal       @db.Decimal(10, 2)
  discountPercent  Decimal       @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  installments     Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  clinic           Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient          Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientPlan      PatientPlan?  @relation(fields: [patientPlanId], references: [id], onDelete: SetNull)
  createdBy        User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items            SaleItem[]
  installmentRows  Installment[]
  payments         Payment[]
  stockMovements   StockMovement[]
  receipt          Receipt?
  fiscalDocument   FiscalDocument?

  @@index([clinicId])
  @@index([patientId])
  @@index([patientPlanId])
  @@index([status])
  @@index([createdAt])
}

model SaleItem {
  id          Int      @id @default(autoincrement())
  saleId      Int
  productId   Int
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model Installment {
  id         Int        @id @default(autoincrement())
  saleId     Int
  number     Int
  amount     Decimal    @db.Decimal(10, 2)
  dueDate    DateTime?
  status     String     @default("PENDING")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  sale       Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@unique([saleId, number])
  @@index([saleId])
  @@index([status])
}

model Payment {
  id            Int          @id @default(autoincrement())
  saleId        Int
  installmentId Int?
  clinicId      Int
  userId        Int?
  amount        Decimal      @db.Decimal(10, 2)
  method        String
  notes         String       @default("")
  receivedAt    DateTime     @default(now())
  sale          Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([installmentId])
  @@index([clinicId])
  @@index([receivedAt])
}

model Receipt {
  id            Int       @id @default(autoincrement())
  saleId        Int       @unique
  clinicId      Int
  patientId     Int?
  number        String    @unique
  subtotal      Decimal   @db.Decimal(10, 2)
  discountAmount Decimal  @db.Decimal(10, 2)
  total         Decimal   @db.Decimal(10, 2)
  bioo3Share    Decimal   @db.Decimal(10, 2)
  clinicShare   Decimal   @db.Decimal(10, 2)
  issuedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient       Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([patientId])
  @@index([issuedAt])
}

model FiscalDocument {
  id             Int       @id @default(autoincrement())
  saleId         Int       @unique
  clinicId       Int
  provider       String
  documentNumber String?
  amount         Decimal   @db.Decimal(10, 2)
  status         String    @default("PENDING_PROVIDER")
  error          String    @default("")
  documentUrl    String?
  issuedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sale           Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  clinic         Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([clinicId])
  @@index([status])
  @@index([createdAt])
}

model AgendaEvent {
  id        Int      @id @default(autoincrement())
  title     String
  startsAt  DateTime
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinicId  Int
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([startsAt])
  @@index([clinicId])
}
